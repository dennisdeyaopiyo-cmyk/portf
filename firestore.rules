rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Portfolio visitor logging & analytics
    match /portfolio_visits/{visitId} {
      allow read, create, delete: if true;
    }

    // Contact inquiries submitted by recruiters/visitors
    match /contact_messages/{messageId} {
      allow read, create, update, delete: if true;
    }

    // Shared testimonials / endorsements guestbook
    match /testimonials/{testimonialId} {
      allow read, create, update, delete: if true;
    }

    // Cloud-synced portfolio projects & customizations
    match /portfolio_projects/{projectId} {
      allow read, write: if true;
    }

    // Connection testing
    match /test/connection {
      allow read: if true;
    }
  }
}
